{
  "name": "link-checkup",
  "version": "0.1.0",
  "description": "Link Checkup (\u53ef\u7591\u94fe\u63a5\u4f53\u68c0): assess a suspicious URL's risk without opening it \u2014 RDAP, redirects, TLS, lookalike detection, public blocklists, DNS. Web UI + CLI + MCP server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "link-checkup": "bin/link-checkup.mjs",
    "link-checkup-mcp": "bin/link-checkup-mcp.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "check": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts"
  },
  "keywords": [
    "phishing",
    "url",
    "security",
    "rdap",
    "typosquatting",
    "mcp",
    "kiro"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ipaddr.js": "^2.5.0",
    "tldts": "^7.4.15",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "fast-check": "^4.10.2",
    "@types/node": "^22.0.0"
  }
}
